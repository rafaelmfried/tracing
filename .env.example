# Portas dos serviços (ajustar se conflitar com algo local)
GO_PORT=8090
NODE_PORT=8091
POSTGRES_PORT=5433
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# Versões base das imagens
GOLANG_VERSION=1.26.2
NODE_VERSION=24-alpine

# Credenciais Postgres (compartilhadas pelos dois serviços)
POSTGRES_DB=tracing
POSTGRES_USER=tracing
POSTGRES_PASSWORD=tracing

# Demonstração — quanto cada query "lenta" demora (segundos, aceita decimal)
QUERY_SLEEP_SECONDS=1

# Grafana
GRAFANA_PASSWORD=admin
